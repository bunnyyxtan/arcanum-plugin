{
  "name": "arcanum-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "PayBox plugin that gives AI agents ARCANUM guarded wallets with contract-enforced spend policy on Base and Arc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunnyyxtan/arcanum-plugin"
  },
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.11.0"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "tsx src/plugin.ts",
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node24 --minify --outfile=dist/plugin.mjs",
    "conformance": "node scripts/conformance.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "unit": "node --import tsx --test test/*.test.ts",
    "e2e:fork": "node --import tsx test/fork.e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "viem": "2.21.55",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
